      { id: 10, cat: "विशेष", likes: 101, text: "इंसान का सबसे बड़ा दुश्मन उसका बेकाबू मन होता है,\nजो उसे वहाँ ले जाता है जहाँ उसकी कोई कदर नहीं होती।" },
      { id: 11, cat: "देसी हरियाणवी", likes: 134, text: "इस सीधे-सादे छोरे नै इतना भी कमज़ोर मत समझिए बावली,\nदिल टूटा है, हौसला आज भी पहाड़ बरगा है।" },
      { id: 12, cat: "देसी हरियाणवी", likes: 121, text: "धोखा देण आळी तो बदलगी अपना रास्ता,\nपर इस छोरे नै आज भी यारी और वफ़ा निभानी आवै है।" },
      { id: 13, cat: "देसी हरियाणवी", likes: 96, text: "म्हारे हरियाणे में बात जुबान की होया करै,\nकाग़ज़ी वादे तो शहर के नकली लोग करया करैं।" },
      { id: 14, cat: "देसी हरियाणवी", likes: 108, text: "जिस छोरे नै तू आम समझकै छोड़गी थी,\nआज उसके लिखे लफ़्ज़ लोग स्टेटस पै लगाया करैं।" },
      { id: 15, cat: "देसी हरियाणवी", likes: 88, text: "शक्ल पै मत जाइये मैडम, देसी ज़रूर हां,\nपर दिल में खोट और यारां गेल्यां धोखा कदे कोनी करया।" },
      { id: 16, cat: "देसी हरियाणवी", likes: 92, text: "वक्त बदलण दे लाडले, जो आज मुँह फेर कै चालैं हैं,\nवे खुद आकर राम-राम करैंगे।" },
      { id: 17, cat: "देसी हरियाणवी", likes: 104, text: "छोरे नै शौक कोनी था शायर बणन का,\nबस तेरी कुछ अधूरी बातां नै कलम पकड़ा दी।" },
      { id: 18, cat: "देसी हरियाणवी", likes: 79, text: "हम तै दिल के साफ थे, इस करके हार गए,\nदिमाग ते खेलण आळे बाज़ी मार गए।" },
      { id: 19, cat: "देसी हरियाणवी", likes: 86, text: "रुतबा तो म्हारा कल भी था अर आज भी रवैगा,\nएक तेरे बदल जाण तै इस छोरे नै कोई फर्क कोनी पड़ता।" },
      { id: 20, cat: "देसी हरियाणवी", likes: 95, text: "दुनियादारी की समझ थोड़ी लेट आई मने,\nपर जितनी आई, घणो के नकाब उतारगी।" },
      { id: 21, cat: "देसी हरियाणवी", likes: 83, text: "इस छोरे नै तेरी हर गलती माफ करी थी,\nअर तनै इसे बात का नाजायज़ फायदा उठा लिया।" },
      { id: 22, cat: "देसी हरियाणवी", likes: 91, text: "माँ के संस्कार और बापू की इज्ज़त बांध राखी है,\nना तै जवाब देण में हम भी किसे तै कम कोनी।" },
      { id: 23, cat: "देसी हरियाणवी", likes: 77, text: "पीसै का घमंड उननै होया करै जिननै नया देख्या हो,\nहम तै यारां की महफ़िल नै ही अपनी दौलत मान्या करां।" },
      { id: 24, cat: "देसी हरियाणवी", likes: 84, text: "छोरे नै चुप रहणा सीख लिया है अब,\nक्योंकि समझण आळे रहे कोनी अर नासमझ नै समझाणा बेकार है।" },
      { id: 25, cat: "देसी हरियाणवी", likes: 110, text: "पाणीपत की माटी का असर है मैडम,\nअकड़ तो राखां कोनी, पर स्वाभिमान पै आंच भी कोनी आण देते।" },
      { id: 26, cat: "देसी हरियाणवी", likes: 72, text: "तेरी मीठी बातां के चक्कर में आपणा चैन खो बैठे,\nभले चंगे हांडै थे, बेमात की टेंशन मोल ले बैठे।" },
      { id: 27, cat: "देसी हरियाणवी", likes: 80, text: "छोरे नै नफरत कोनी करी कदे तोहे तै,\nबस अब भरोसा करण की हिम्मत खत्म होगी।" },
      { id: 28, cat: "देसी हरियाणवी", likes: 89, text: "म्हारी खामोशी नै म्हारी कमज़ोरी मत मानियो,\nतूफान आण तै पहले भी मौसम शांत होया करै।" },
      { id: 29, cat: "दर्द और तन्हाई", likes: 97, text: "कुछ ज़ख्म ऐसे होते हैं जो कभी दिखते नहीं,\nमगर रात की खामोशी में बहुत ज़ोर से दुखते हैं।" },
      { id: 30, cat: "दर्द और तन्हाई", likes: 85, text: "हँसता हुआ चेहरा देखकर सबने कहा खुशकिस्मत हो,\nकिसी ने ये न पूछा कि इस मुस्कान के पीछे कितने आँसू छिपे हैं।" },
      { id: 31, cat: "दर्द और तन्हाई", likes: 78, text: "अब किसी से कोई गिला नहीं रहा मुझे,\nजब अपने ही न समझे तो गैरों से क्या उम्मीद रखें।" },
      { id: 32, cat: "दर्द और तन्हाई", likes: 90, text: "एक उम्र गुज़ार दी हमने जिनकी फिक्र में,\nउन्हें एक पल भी न लगा हमें परायों की कतार में खड़ा करने में।" },
      { id: 33, cat: "दर्द और तन्हाई", likes: 68, text: "नींद भी अब सौदेबाज़ी करने लगी है मुझसे,\nकहती है पहले उसकी यादों को सुलाओ फिर मैं आऊँगी।" },
      { id: 34, cat: "दर्द और तन्हाई", likes: 74, text: "भीड़ में रहकर भी जो इंसान अकेला हो जाए,\nसमझ लेना उसने किसी अपने को बहुत करीब से बदलते देखा है।" },
      { id: 35, cat: "दर्द और तन्हाई", likes: 82, text: "कितना अजीब है न ये दिल का दर्द भी,\nलिखो तो लोग वाह-वाह करते हैं और सहो तो जान निकलती है।" },
      { id: 36, cat: "दर्द और तन्हाई", likes: 66, text: "हमने तो बस थोड़ा सा वक्त माँगा था तुझसे,\nतूने तो पूरी ज़िंदगी भर का इंतज़ार दे दिया।" },
      { id: 37, cat: "दर्द और तन्हाई", likes: 71, text: "कभी-कभी इंसान रोता नहीं है,\nबस अंदर ही अंदर इतना खामोश हो जाता है कि शोर भी सुनाई नहीं देता।" },
      { id: 38, cat: "दर्द और तन्हाई", likes: 87, text: "टूटे हुए काँच की तरह हो गई हैं उम्मीदें मेरी,\nसमेटने की कोशिश करता हूँ तो खुद के ही हाथ ज़ख्मी हो जाते हैं।" },
      { id: 39, cat: "दर्द और तन्हाई", likes: 64, text: "वो पूछते हैं आजकल शायरी में इतना दर्द क्यों है,\nअब उन्हें कैसे बताऊँ कि दवा देने वाले ही मर्ज़ दे गए।" },
      { id: 40, cat: "दर्द और तन्हाई", likes: 76, text: "रात भर जागते हैं सिर्फ इस ख्याल से,\nकि शायद तुझे भी कभी मेरी तरह बेचैनी होती होगी।" },
      { id: 41, cat: "दर्द और तन्हाई", likes: 69, text: "छूट गया जो हाथ, उसका मलाल आज भी है,\nमैं कहाँ गलत था, बस यही एक सवाल आज भी है।" },
      { id: 42, cat: "दर्द और तन्हाई", likes: 81, text: "सन्नाटा बहुत है मेरे कमरे की दीवारों में,\nजब से तेरी आवाज़ ने यहाँ आना बंद किया है।" },
      { id: 43, cat: "दर्द और तन्हाई", likes: 73, text: "थक गया हूँ हर किसी को अपनी सफाई देते-देते,\nअब जो जैसा सोचे मेरे बारे में, उसका भला हो।" },
      { id: 44, cat: "दर्द और तन्हाई", likes: 93, text: "यूँ ही नहीं लिखता सावन हर पन्ने पर ग़म के किस्से,\nकुछ पन्ने ज़िंदगी ने बिना पूछे ही जला दिए।" },
      { id: 45, cat: "दर्द और तन्हाई", likes: 62, text: "बचपन ही अच्छा था जब खिलौने टूटने पर रोते थे,\nअब तो दिल टूटने पर भी मुस्कुराना पड़ता है।" },
      { id: 46, cat: "दर्द और तन्हाई", likes: 75, text: "कोई मिला ही नहीं ऐसा जो बिन कहे समझ सके,\nहर किसी ने बस अपने मतलब के हिसाब से परखा मुझे।" },
      { id: 47, cat: "दर्द और तन्हाई", likes: 67, text: "यादों की एक पुरानी संदूक रखी है दिल में,\nजब भी खोलता हूँ, आँखें नम हो जाती हैं।" },
      { id: 48, cat: "दर्द और तन्हाई", likes: 79, text: "सब कुछ पा लिया ज़िंदगी की दौड़ में,\nबस वो सुकून खो गया जो तेरे साथ बैठने से मिलता था।" },
      { id: 49, cat: "मोहब्बत", likes: 103, text: "मोहब्बत का कोई हिसाब नहीं होता साहिब,\nये वो इबादत है जो एकतरफ़ा भी पूरी शिद्दत से निभाई जाती है।" },
      { id: 50, cat: "मोहब्बत", likes: 94, text: "हज़ारों चेहरे देखे इस दुनिया की भीड़ में,\nमगर दिल जाकर रुका तो सिर्फ तेरी सादगी पर।" },
      { id: 51, cat: "मोहब्बत", likes: 88, text: "तू मिले या न मिले ये तो मुकद्दर की बात है,\nमगर तुझे चाहना मेरी ज़िंदगी का सबसे खूबसूरत इत्तेफ़ाक है।" },
      { id: 52, cat: "मोहब्बत", likes: 76, text: "तेरी एक झलक पाने को तरस जाती हैं निगाहें,\nपता नहीं कौन सा जादू है तेरी उन मासूम अदाओं में।" },
      { id: 53, cat: "मोहब्बत", likes: 82, text: "दुआओं में जब भी हाथ उठते हैं मेरे,\nमेरी ख्वाहिशों से पहले तेरी सलामती का नाम आता है।" },
      { id: 54, cat: "मोहब्बत", likes: 71, text: "बहुत शोर था मेरे दिल के भीतर,\nतेरे एक 'अपना ख्याल रखना' कहने से सब शांत हो गया।" },
      { id: 55, cat: "मोहब्बत", likes: 89, text: "चाँद में भी दाग़ दिखता है ज़माने को,\nमगर मुझे तो तेरी हर कमी से भी मोहब्बत है।" },
      { id: 56, cat: "मोहब्बत", likes: 68, text: "फासले चाहे कितने भी बढ़ जाएँ हमारे दरमियान,\nमेरे दिल के एक कोने में हमेशा तेरा ही हक रहेगा।" },
      { id: 57, cat: "मोहब्बत", likes: 74, text: "इश्क़ अगर सच्चा हो तो वक्त का मोहताज नहीं होता,\nसालों बाद भी नाम सुनते ही धड़कनें तेज़ हो जाती हैं।" },
      { id: 58, cat: "मोहब्बत", likes: 91, text: "मैं शायर तो नहीं था तेरे मिलने से पहले,\nये तो तेरी निगाहों ने मुझे लफ़्ज़ों से खेलना सिखा दिया।" },
      { id: 59, cat: "मोहब्बत", likes: 63, text: "कुछ रिश्ते बिना किसी नाम के भी बहुत खास होते हैं,\nजो पास न होकर भी हर पल दिल के पास होते हैं।" },
      { id: 60, cat: "मोहब्बत", likes: 77, text: "तेरे नाम से शुरू होती थी मेरी हर कहानी,\nऔर आज भी हर पन्ने के आखिर में तेरा ही ज़िक्र छूट जाता है।" },
      { id: 61, cat: "मोहब्बत", likes: 84, text: "उम्र भर का साथ न सही, वो चंद मुलाकातों के पल ही काफी हैं,\nसावन को अपनी पूरी ज़िंदगी गुज़ारने के लिए।" },
      { id: 62, cat: "मोहब्बत", likes: 69, text: "किसी को पा लेना ही मोहब्बत नहीं होती,\nकिसी की खुशी के लिए पीछे हट जाना भी इश्क़ का दर्जा रखता है।" },
      { id: 63, cat: "मोहब्बत", likes: 72, text: "जब भी हवा का कोई ठंडा झोंका छूकर गुज़रता है,\nऐसा लगता है जैसे तूने दूर से मेरा हाल पूछा हो।" },
      { id: 64, cat: "मोहब्बत", likes: 86, text: "तेरी हँसी आज भी मेरी सबसे पसंदीदा धुन है,\nफिर चाहे वो अब किसी और के लिए ही क्यों न हो।" },
      { id: 65, cat: "मोहब्बत", likes: 70, text: "काग़ज़ की कश्ती सा था मेरा दिल,\nतेरी मोहब्बत के समंदर में डूबकर भी आबाद हो गया।" },
      { id: 66, cat: "मोहब्बत", likes: 65, text: "न कोई शर्त थी, न कोई उम्मीद रखी थी,\nहमने तो बस तुझसे बेपनाह मोहब्बत की थी।" },
      { id: 67, cat: "बेवफ़ाई", likes: 99, text: "वादे तो सात जन्मों के किए थे उसने,\nमगर निभाने की बारी आई तो एक मौसम भी साथ न चल सकी।" },
      { id: 68, cat: "बेवफ़ाई", likes: 91, text: "कितनी आसानी से कह दिया उसने कि अब भूल जाओ मुझे,\nजैसे इतने सालों का रिश्ता कोई रेत का घर था।" },
      { id: 69, cat: "बेवफ़ाई", likes: 84, text: "कसूर उसका नहीं था जो वो बदल गई,\nकसूर मेरा था जो मैंने उसे खुद से ज़्यादा चाह लिया।" },
      { id: 70, cat: "बेवफ़ाई", likes: 77, text: "जब नया हमसफ़र मिल जाता है लोगों को,\nतो पुराने की वफ़ाएँ भी बोझ लगने लगती हैं।" },
      { id: 71, cat: "बेवफ़ाई", likes: 88, text: "झूठी कसमें खाने का हुनर कोई तुझसे सीखे,\nहम तो आज भी तेरे झूठ को सच मानकर बैठे हैं।" },
      { id: 72, cat: "बेवफ़ाई", likes: 73, text: "मजबूरी का नाम देकर उसने अपना दामन तो बचा लिया,\nमगर मेरे भरोसे को हमेशा के लिए मार दिया।" },
      { id: 73, cat: "बेवफ़ाई", likes: 80, text: "बदलना तो फितरत होती है मौसम की,\nहमें क्या पता था कि इंसान भी मौसम से तेज़ रंग बदलते हैं।" },
      { id: 74, cat: "बेवफ़ाई", likes: 69, text: "हम वफ़ा की उम्मीद भी किससे कर बैठे,\nजिसे अपने वादों की ही कोई कीमत पता नहीं थी।" },
      { id: 75, cat: "बेवफ़ाई", likes: 95, text: "जा तुझे आज़ाद किया अपनी हर एक याद से,\nपर जब कोई तेरा दिल तोड़ेगा तो तुझे सावन ज़रूर याद आएगा।" },
      { id: 76, cat: "बेवफ़ाई", likes: 74, text: "अजनबी बनकर मिले थे और अजनबी ही बना गए,\nबीच के कुछ साल बस एक खूबसूरत धोखा थे।" },
