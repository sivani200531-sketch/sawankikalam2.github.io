    .admin-box {
      background: var(--surface);
      border: 2px solid var(--gold);
      border-radius: 14px;
      padding: 24px;
    }

    .admin-box h3 {
      color: var(--gold);
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .form-grid {
      display: grid;
      gap: 12px;
    }

    .input-field {
      width: 100%;
      padding: 12px;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 8px;
      font-family: inherit;
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 30px 20px;
      text-align: center;
      color: var(--muted);
      font-size: 0.85rem;
    }

    #toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--gold);
      color: #000;
      padding: 10px 18px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.88rem;
      display: none;
      z-index: 999;
      box-shadow: 0 6px 20px rgba(0,0,0,0.4);
    }
  </style>
</head>
