      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
    }

    .action-group {
      display: flex;
      gap: 8px;
    }

    .icon-btn {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 5px 11px;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
      transition: 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .icon-btn:hover {
      border-color: var(--gold);
      color: var(--text);
    }

    .icon-btn.liked {
      color: var(--accent);
      border-color: var(--accent);
    }

    .delete-btn {
      background: rgba(225, 29, 72, 0.15);
      color: #f43f5e;
      border: 1px solid #f43f5e;
      padding: 4px 9px;
      border-radius: 6px;
      font-size: 0.75rem;
      cursor: pointer;
    }

    .load-more-wrap {
      text-align: center;
      margin-top: 32px;
    }

    .btn-gold {
      background: var(--gold);
      color: #000;
      border: none;
      padding: 12px 28px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      transition: 0.2s;
    }

    .btn-gold:hover {
      opacity: 0.9;
    }

    #adminPanel {
      display: none;
      max-width: 1180px;
      margin: 24px auto;
      padding: 0 20px;
