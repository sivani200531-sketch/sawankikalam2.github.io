    }

    .nav-container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 14px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-logo {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, #d4af37, #8a640f);
      color: #000;
      font-weight: 800;
      font-size: 1.3rem;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Georgia, serif;
    }

    .brand-title {
      font-family: Georgia, 'Noto Serif Devanagari', serif;
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 0.3px;
    }

    .brand-sub {
      font-size: 0.72rem;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 1.4px;
      display: block;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn-outline {
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 0.85rem;
      cursor: pointer;
      transition: 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .btn-outline:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .hero {
      max-width: 1180px;
      margin: 0 auto;
      padding: 48px 20px 30px;
      text-align: center;
      border-bottom: 1px solid var(--border);
    }

    .verified-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 14px;
      border-radius: 50px;
      background: var(--gold-soft);
      color: var(--gold);
      font-size: 0.8rem;
      font-weight: 600;
      margin-bottom: 16px;
      border: 1px solid rgba(212, 175, 55, 0.3);
    }

    .hero h1 {
      font-family: Georgia, 'Noto Serif Devanagari', serif;
      font-size: clamp(2rem, 5vw, 3.2rem);
      font-weight: 700;
      margin-bottom: 12px;
    }

    .hero h1 span {
      color: var(--gold);
    }

    .hero p {
      max-width: 680px;
      margin: 0 auto 24px;
      color: var(--muted);
      font-size: 1.02rem;
    }

    .stats-bar {
      display: flex;
      justify-content: center;
      gap: 32px;
      flex-wrap: wrap;
      margin-top: 20px;
    }

    .stat-box {
      text-align: center;
    }

    .stat-num {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--gold);
    }

    .stat-label {
      font-size: 0.8rem;
      color: var(--muted);
    }

