    const STORAGE_KEY = "sawan_official_shayaris_v2";
    const ADMIN_PASS = "sawan07";

    let shayariList = JSON.parse(localStorage.getItem(STORAGE_KEY)) || defaultShayaris;
    let currentCategory = "सभी";
    let visibleCount = 18;
    let isAdmin = false;

    function saveToStorage() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(shayariList));
      document.getElementById("totalShayariCount").innerText = shayariList.length;
    }

    function getFilteredShayaris() {
      const q = document.getElementById("searchInput").value.trim().toLowerCase();
      return shayariList.filter(item => {
        const matchCat = currentCategory === "सभी" || item.cat === currentCategory;
        const matchQuery = !q || item.text.toLowerCase().includes(q) || item.cat.toLowerCase().includes(q);
        return matchCat && matchQuery;
      });
    }

    function renderShayaris() {
      const grid = document.getElementById("shayariGrid");
      const filtered = getFilteredShayaris();
      const slice = filtered.slice(0, visibleCount);

      document.getElementById("totalShayariCount").innerText = shayariList.length;

      if (slice.length === 0) {
        grid.innerHTML = `<p style="grid-column:1/-1; text-align:center; color:var(--muted); padding:40px;">कोई शायरी नहीं मिली। कृपया दूसरा शब्द खोजें।</p>`;
        document.getElementById("loadMoreWrap").style.display = "none";
        return;
      }

      grid.innerHTML = slice.map((item, idx) => `
        <article class="shayari-card">
          <div>
            <div class="card-top">
              <span class="cat-tag">${item.cat}</span>
              <span class="serial-no">#${item.id}</span>
            </div>
            <div class="shayari-text">${item.text}</div>
          </div>
          <div>
            <div class="signature">— सावन की कलम से ✍️</div>
            <div class="card-footer">
              <div class="action-group">
                <button class="icon-btn" onclick="likeShayari(${item.id}, this)">❤️ <span>${item.likes}</span></button>
                <button class="icon-btn" onclick="copyShayari(\`${item.text.replace(/`/g, '')}\`)">📋 कॉपी</button>
                <button class="icon-btn" onclick="whatsappShare(\`${item.text.replace(/`/g, '')}\`)">📲 शेयर</button>
              </div>
              ${isAdmin ? `<button class="delete-btn" onclick="deleteShayari(${item.id})">🗑️ हटाएँ</button>` : ``}
            </div>
          </div>
        </article>
      `).join("");

      document.getElementById("loadMoreWrap").style.display =
        visibleCount < filtered.length ? "block" : "none";
    }

    function selectCategory(cat, btn) {
      currentCategory = cat;
      visibleCount = 18;
      document.querySelectorAll(".cat-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderShayaris();
    }

    function resetAndRender() {
      visibleCount = 18;
      renderShayaris();
    }

    function loadMore() {
      visibleCount += 18;
      renderShayaris();
    }

    function likeShayari(id, btn) {
      const item = shayariList.find(s => s.id === id);
      if (item && !btn.classList.contains("liked")) {
        item.likes += 1;
        btn.classList.add("liked");
        btn.querySelector("span").innerText = item.likes;
        saveToStorage();
      }
    }

    function copyShayari(text) {
      const fullText = `${text}\n\n— सावन की कलम से ✍️`;
      navigator.clipboard.writeText(fullText);
      showToast("✅ शायरी कॉपी हो गई!");
    }

    function whatsappShare(text) {
      const fullText = encodeURIComponent(`${text}\n\n— सावन की कलम से ✍️\nपूरी शायरी पढ़ें: ${window.location.href}`);
      const waUrl = "https:" + "//wa.me/?text=" + fullText;
      window.open(waUrl, "_blank");
    }

    function shareWebsite() {
      navigator.clipboard.writeText(window.location.href);
      showToast("🔗 वेबसाइट का लिंक कॉपी हो गया!");
    }

    function handleAdminAccess() {
      if (isAdmin) {
        document.getElementById("adminPanel").scrollIntoView({ behavior: "smooth" });
        return;
      }
      const pass = prompt("🔒 केवल लेखक (Sawan) के लिए:\nअपना एडमिन पासवर्ड दर्ज करें:");
      if (pass === ADMIN_PASS) {
        isAdmin = true;
        document.getElementById("adminPanel").style.display = "block";
        document.getElementById("adminToggleBtn").innerText = "👑 Admin Active";
        renderShayaris();
        showToast("🔓 स्वागत है सावन! एडमिन पैनल खुल गया।");
      } else if (pass !== null) {
        alert("❌ गलत पासवर्ड! केवल सावन ही नई शायरी जोड़ सकते हैं।");
      }
    }

    function logoutAdmin() {
      isAdmin = false;
      document.getElementById("adminPanel").style.display = "none";
      document.getElementById("adminToggleBtn").innerText = "🔒 Admin";
      renderShayaris();
      showToast("🔒 एडमिन लॉगआउट हो गया।");
    }

    function addShayariByAdmin() {
      if (!isAdmin) return;
      const cat = document.getElementById("newCategory").value;
      const text = document.getElementById("newShayariText").value.trim();
      if (!text) {
        alert("कृपया शायरी लिखें!");
        return;
      }
      const newEntry = {
        id: shayariList.length + 1,
        cat: cat,
        likes: 1,
        text: text
      };
      shayariList.unshift(newEntry);
      saveToStorage();
      document.getElementById("newShayariText").value = "";
      renderShayaris();
      showToast("✨ आपकी नई शायरी पब्लिश हो गई!");
    }

    function deleteShayari(id) {
      if (!isAdmin) return;
      if (confirm("क्या आप वाकई यह शायरी हटाना चाहते हैं?")) {
        shayariList = shayariList.filter(s => s.id !== id);
        saveToStorage();
        renderShayaris();
        showToast("🗑️ शायरी हटा दी गई।");
      }
    }

    function exportUpdatedHTML() {
      const updatedHTML = document.documentElement.outerHTML.replace(
        /const defaultShayaris = \[[\s\S]*?\];/,
        `const defaultShayaris = ${JSON.stringify(shayariList, null, 2)};`
      );
      const blob = new Blob(["<!DOCTYPE html>\n" + updatedHTML], { type: "text/html" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "index.html";
      a.click();
      showToast("💾 नई index.html डाउनलोड हो गई!");
    }

    function toggleTheme() {
      const body = document.body;
      const btn = document.getElementById("themeBtn");
      if (body.getAttribute("data-theme") === "light") {
        body.removeAttribute("data-theme");
        btn.innerText = "☀️ Light";
      } else {
        body.setAttribute("data-theme", "light");
        btn.innerText = "🌙 Dark";
      }
    }

    function showToast(msg) {
      const t = document.getElementById("toast");
      t.innerText = msg;
      t.style.display = "block";
      setTimeout(() => { t.style.display = "none"; }, 2500);
    }

    renderShayaris();
  </script>
