      --text: #f3f4f6;
      --muted: #9ca3af;
      --accent: #e11d48;
    }

    [data-theme="light"] {
      --bg: #faf7f2;
      --surface: #ffffff;
      --surface-hover: #f5efe6;
      --border: #e5dec9;
      --gold: #9a6f0a;
      --gold-soft: rgba(154, 111, 10, 0.12);
      --text: #1c1917;
      --muted: #57534e;
